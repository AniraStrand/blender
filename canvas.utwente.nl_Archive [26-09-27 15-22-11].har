igation menu\"><ul id=\"section-tabs\"><li class=\"section\"><a id=\"home-link\" href=\"/courses/19143\" class=\"home\">Home</a></li><li class=\"section\"><a id=\"announcements-link\" href=\"/courses/19143/announcements\" class=\"announcements\">Announcements</a></li><li class=\"section\"><a id=\"context_external_tool_40-link\" href=\"/courses/19143/external_tools/40\" class=\"context_external_tool_40\">OSIRIS Course Information</a></li><li class=\"section\"><a id=\"syllabus-link\" href=\"/courses/19143/assignments/syllabus\" class=\"syllabus\">Syllabus</a></li><li class=\"section\"><a id=\"modules-link\" href=\"/courses/19143/modules\" class=\"modules\">Modules</a></li><li class=\"section\"><a id=\"grades-link\" href=\"/courses/19143/grades\" class=\"grades\">Grades</a></li><li class=\"section\"><a id=\"people-link\" href=\"/courses/19143/users\" class=\"people\">People</a></li><li class=\"section\"><a id=\"notebook-link\" href=\"/courses/19143/notebook\" class=\"notebook\">Notebook</a></li></ul></nav>\n          </div>\n        </div>\n      <div id=\"not_right_side\" class=\"ic-app-main-content\">\n        <div id=\"content-wrapper\" class=\"ic-Layout-contentWrapper\">\n          \n          <div id=\"content\" class=\"ic-Layout-contentMain\" role=\"main\">\n            \n<style>\n  #right-side-wrapper {\n    height: 100%;\n  }\n\n  .assignment_header {\n    border-bottom: 1px solid #a4a4a4;\n    overflow: hidden;\n  }\n\n  #assignment_head {\n    margin-top: 0;\n    font-weight: bold;\n  }\n\n  .lock_explanation {\n    text-align: left;\n    margin-top: 20px;\n  }\n</style>\n\n\n\n<div id=\"assignment_show\" class=\"assignment content_underline_links\" data-lti-page-content=\"true\">\n    <!--Student View-->\n    <div class='assignment-title'>\n      <div class='title-content'>\n        <h1 class=\"title\">\n          Processes, Threads and IPC\n        </h1>\n      </div>\n      <div class='assignment-buttons'>\n        \n\n        <button type=\"button\" class=\"Button Button--primary submit_assignment_link \">Start Assignment</button>\n      </div>\n    </div>\n      <div id=\"assignment_asset_processor_eula\"></div>\n    \n<ul class='student-assignment-overview'>\n  <li>\n    <span class='title'>Due</span>\n    <span class='value'>\n          <span class=\"date_text\">\n              <span class=\"display_date\">27 Sep</span> by <span class=\"display_time\">23:59</span>\n          </span><!--\n        --></span>\n  </li>\n    <li>\n      <span class='title'>Points</span>\n      <span class='value'>10</span>\n    </li>\n    <li>\n      <span class='title'>Submitting</span>\n      <span class='value'>a file upload</span>\n    </li>\n  \n\n  <div class=\"clear\"></div>\n</ul>\n\n\n  <div class=\"clear\"></div>\n\n\n  <div class=\"clear\"></div>\n\n\n\n\n  <div class=\"description user_content \" data-resource-type=\"assignment.body\" data-resource-id=168726><p>Please find all of the details regarding the assignment (steps, submission guidelines, rubric, etc.) below:</p>\n<p><a class=\"instructure_file_link instructure_scribd_file auto_open\" title=\"Assignment 2 - Processes, Threads and IPC.pdf\" href=\"/courses/19143/files/5687450?wrap=1\" target=\"_blank\">View/download the assignment here</a></p>\n<p>&nbsp;</p></div>\n\n\n  <div style=\"display: none;\">\n    <span class=\"timestamp\">1790546399</span>\n    <span class=\"due_date_string\">09/27/2026</span>\n    <span class=\"due_time_string\">11:59pm</span>\n  </div>\n</div>\n\n\n  \n<div style=\"display: none;\" id=\"submit_assignment\" data-context_code=\"course_19143\" data-asset_string=\"assignment_168726\">\n  <div class=\"content\" id=\"submit_assignment_tabs\">\n    <ul>\n        <li><a href=\"#submit_online_upload_form\" class=\"submit_online_upload_option\">File upload</a></li>\n        <li><a href=\"#submit_from_external_tool_form_42\"\n          class=\"external-tool\"\n          data-id=\"42\"\n          data-name=\"Google Drive\">Google Drive</a></li>\n   