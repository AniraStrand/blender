 period\",\"due_on_date_5ffb2182\":\"Due on date\",\"duplicate_31cec192\":\"Duplicate\",\"duplicate_assignment_name_3ca7d753\":\"Duplicate Assignment %{name}\",\"duplicate_quiz_name_79fdcb3e\":\"Duplicate Quiz %{name}\",\"edit_assignment_group_c04c4af0\":\"Edit assignment group\",\"edit_assignment_name_a8f7fae1\":\"Edit assignment %{name}\",\"edit_assignment_name_mastery_paths_40b50541\":\"Edit Assignment %{name} Mastery Paths\",\"edit_c5fbea07\":\"Edit\",\"edit_mastery_paths_for_name_c9fc59f9\":\"Edit Mastery Paths for %{name}\",\"edit_mastery_paths_for_title_label_41d81451\":\"Edit Mastery Paths for %{title_label}\",\"edit_outcome_867a0381\":\"Edit outcome\",\"edit_outcome_group_f82e0210\":\"Edit outcome group\",\"edit_quiz_ededddd8\":\"Edit quiz\",\"edit_role_1e96ad20\":\"Edit role\",\"edited_c4fcbdbf\":\"Edited:\",\"either_change_group_limits_or_add_more_groups_2d996997\":\"Either change group limits or add more groups.\",\"enabling_this_option_automatically_moves_course_pa_15f755b3\":\"Enabling this option automatically moves Course Pacing assignment due dates to after the end date. Input for Time, Location and Calendar will be disabled.\",\"ends_at_9a62b528\":\"Ends at\",\"enter_or_find_an_external_tool_url_6aebbd0d\":\"Enter or find an external tool URL\",\"event_date_c9459fe3\":\"Event Date\",\"event_end_time_ef830e66\":\"Event End Time\",\"event_start_time_441b491f\":\"Event Start Time\",\"event_title_7f1051a6\":\"Event title\",\"every_665d821e\":\"Every\",\"example_84698b7d\":\"Example\",\"example_final_score_355aff0f\":\"Example final score\",\"example_item_scores_6726c689\":\"Example item scores\",\"excused_cf8792eb\":\"Excused\",\"expand_collapse_title_outcome_group_student_meets__46ffef48\":\"Expand/collapse %{title} Outcome Group, student meets mastery of %{mastery_count} of %{count} outcomes\",\"file_not_available_1869c733\":\"file not available\",\"find_8d605019\":\"Find\",\"folder_browsing_tree_1f00a3ae\":\"Folder Browsing Tree\",\"for_974cbb84\":\"For\",\"friendly_description_57f7fdde\":\"Friendly Description\",\"full_a4b1e0bd\":\"Full\",\"go_back_ed239e69\":\"Go Back\",\"graders_cannot_view_each_other_s_names_b1fa7899\":\"Graders cannot view each other's names\",\"graders_cannot_view_student_names_2e8d3ff9\":\"Graders cannot view student names\",\"grading_category_aligned_with_sis_f8f64792\":\"Grading category aligned with SIS\",\"group_details_e51122f1\":\"Group Details\",\"group_leader_8d1cf8aa\":\"Group Leader\",\"group_set_name_2aed2347\":\"Group Set Name\",\"groups.manage.auto_leadership_controls.auto_first_group_leader\":\"Set first student to join as group leader\",\"groups.manage.auto_leadership_controls.auto_group_leader\":\"Automatically assign a student group leader\",\"groups.manage.auto_leadership_controls.auto_random_group_leader\":\"Set a random student as group leader\",\"groups.manage.auto_leadership_controls.leadership\":\"Leadership\",\"groups.manage.group_categories.account_group_explanation\":\"Account-level student groups are a good way to group students without being tied to a specific course. Every student group gets their own calendar, discussion board and collaboration tools so they can organise themselves and work together more effectively.\",\"groups.manage.group_categories.course_group_explanation\":\"Student groups are a useful way to organise students for things like group projects or papers. Every student group gets their own calendar, discussion board and collaboration tools so they can organise themselves and work together more effectively.\",\"groups.manage.group_categories.group_assignment_instructions\":\"You can randomly assign students to groups of a specific size, or manually create and organise the groups. Once your groups are created, you can set assignments to be \\\"group submission\\\" assignments, which means each group will have one submission for all users of that group.\",\"groups.manage.group_categories.group_set\":\"Group set\",\"groups.manage.group_categories.headings.account_groups\":\"Account-level student groups\",\"groups.manage.group_categories.headings.course_groups\":\"Student groups\",\"groups.manage.group_categories.headings.groups\":\"Groups\",\"groups.manage.group_categories.tabs.everyone\":\"Everyone\",\"groups.manage.group_category_detail.category_settings\":\"Settings\",\"groups.manage.group_category_detail.delete_category_option\":\"Delete\",\"groups.manage.group_category_detail.edit_category_option\":\"Edit\",\"groups.manage.group_category_detail.group\":\"Group\",\"groups.manage.group_category_detail.group_limit_blurb\":\"Groups are limited to *%{group_limit}* members.\",\"groups.manage.group_category_detail.import\":\"Import\",\"groups.manage.group_category_detail.message_all_unassigned_option\":\"Message All Unassigned Students\",\"groups.manage.group_category_detail.randomly_assign_students_option\":\"Randomly assign students\",\"groups.manage.group_category_detail.restricted_self_signup_blurb\":\"All students in a group are required to be in the same section.\",\"groups.manage.group_category_detail.self_organized_warning\":\"These groups are self-organised by students. Unlike other types of groups, students can belong to more than one of these groups at a time, so these groups cannot be used for graded assignments.\",\"groups.manage.group_category_detail.self_signup_blurb\":\"Self sign-up is enabled for these groups.\",\"groups.manage.group_category_detail.settings\":\"Settings\",\"groups.manage.group_category_detail.uncategorized_groups\":\"These groups are not associated to any particular group set. Because they were imported via SIS, they can only be updated or deleted via SIS.\",\"groups.manage.group_category_edit.allow_self_signup\":\"Allow self sign-up\",\"groups.manage.group_category_edit.cancel\":\"Cancel\",\"groups.manage.group_category_edit.group_limit_override\":\"Changing this will override any individually set group limits\",\"groups.manage.group_category_edit.group_set_name\":\"Group Set Name\",\"groups.manage.group_category_edit.require_same_section\":\"Require group members to be in the same section\",\"groups.manage.group_category_edit.save\":\"Save\",\"groups.manage.group_category_edit.saving\":\"Saving...\",\"groups.manage.group_users.add_student\":\"Add a student to get started.\",\"groups.manage.group_users.add_user\":\"Add a user to get started.\",\"groups.manage.group_users.greater_than_three\":\"Please enter a search term with three or more characters\",\"groups.manage.group_users.no_matching_students\":\"No matching students.\",\"groups.manage.group_users.no_matching_users\":\"No matching users.\",\"groups.manage.group_users.no_students\":\"There are currently no students in this group.\",\"groups.manage.group_users.no_users\":\"There are currently no users in this group.\",\"groups.manage.self_signup_help.about_self_signup_groups\":\"About Self Sign-up Groups\",\"groups.manage.self_signup_help.self_signup_deadline_description\":\"You can create sets of groups where students can sign up on their own. Students are still limited to being in only one group in the set, but this way students can organise themselves into groups instead of needing the teacher to do the work. With this option enabled, students can move themselves from one group to another. However, you can set an end date to close self-sign-up to prevent students from joining or changing groups after a certain date.\",\"groups.manage.self_signup_help.self_signup_description\":\"You can create sets of groups where students can sign up on their own. Students are still limited to being in only one group in the set, but this way students can organise themselves into groups instead of needing the teacher to do the work. With this option enabled, students can move themselves from one group to another. Note that as long as this option is enabled, students can move themselves from one group to another.\",\"groups_need_to_be_created_before_users_can_be_adde_8e55609c\":\"Groups need to be created before users can be added.\",\"have_students_sign_up_in_groups_d6cfd4d2\":\"Have students sign up in groups\",\"hide_from_gradebook_view_and_student_grades_view_22a5a606\":\"Hide from gradebook view and student grades view\",\"if_you_change_an_assignment_s_points_possible_you__dba531cb\":\"If you change an assignment's points possible, you must grade any submissions again.\",\"import_1b31507\":\"Import\",\"imported_from_posttosisname_f7cc9258\":\"Imported from %{postToSISName}\",\"importing_name_8f2b131d\":\"Importing \\\"%{name}\\\"\",\"in_order_to_import_a_large_quantity_of_outcomes_at_935f7e25\":\"In order to import a large quantity of outcomes at once, or to update your existing outcomes, please \\\"\\u003e\\u003ca href=\\\"/doc/api/file.outcomes_csv.html\\\"\\u003efollow the CSV format\\u003c/a\\u003e.\",\"inactive_cd40317f\":\"inactive\",\"include_this_assignment_s_grades_when_syncing_to_y_55bfa487\":\"Include this assignment's grades when syncing to your school's Student Information System\",\"input_event_title_1d4c8b10\":\"Input Event Title\",\"knowledge_chats_9a8a7edd\":\"Knowledge chats\",\"knowledge_chats_in_this_course_won_t_be_copied_alo_43bb1695\":\"Knowledge Chats in this course won't be copied along with the other content.\",\"knowledge_chats_in_this_course_won_t_be_exported_a_7a8d3e95\":\"Knowledge Chats in this course won't be exported along with the other content.\",\"knowledge_chats_in_this_course_won_t_be_synced_alo_210f9a28\":\"Knowledge Chats in this course won't be synced along with the other content.\",\"last_edit_ascending_6a18dba4\":\"Last Edit: Ascending\",\"last_edit_descending_6b7ee755\":\"Last Edit: Descending\",\"late_bd436902\":\"LATE\",\"latest_assessment_a85280ef\":\"Latest Assessment\",\"limit_each_time_slot_to_num_participants_groups_us_14ec4d65\":\"Limit each time slot to %{num_participants} *groups.* **users.**\",\"limit_participants_to_attend_num_appointments_appo_dd3fd62f\":\"Limit participants to attend %{num_a